# Copy to .env on the production server and run: chmod 0600 .env
POSTGRES_DB=gkfeed
POSTGRES_USER=gkfeed_owner
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
POSTGRES_DATA_DIR=/srv/gkfeed/postgres/17/data

# dbmate and operator tools use this URL. Percent-encode special password bytes.
DATABASE_URL=postgres://gkfeed_owner:replace-with-a-long-random-password@127.0.0.1:5432/gkfeed?sslmode=disable
