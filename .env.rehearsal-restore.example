# Local only. Copy to .env.rehearsal-restore and keep mode 0600.
POSTGRES_DB=gkfeed
POSTGRES_USER=gkfeed_owner
POSTGRES_PASSWORD=replace-with-a-different-local-random-password
POSTGRES_PORT=55435
DATABASE_URL=postgres://gkfeed_owner:replace-with-a-different-local-random-password@127.0.0.1:55435/gkfeed?sslmode=disable
API_LOGIN_PASSWORD=replace-with-a-local-api-password
PARSER_LOGIN_PASSWORD=replace-with-a-local-parser-password
