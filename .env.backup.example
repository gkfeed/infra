# Copy to a private host path, replace every placeholder, and chmod 0600.
# The LOGIN identity is provisioned by the operator outside Git and inherits
# only the gkfeed_backup NOLOGIN group role.
BACKUP_DATABASE_URL=postgres://gkfeed_backup_login:replace-with-a-long-random-password@127.0.0.1:5432/gkfeed?sslmode=disable

TELEGRAM_BOT_TOKEN=replace-with-the-bot-token
TELEGRAM_CHAT_ID=replace-with-the-private-chat-id

BACKUP_SPOOL_DIR=/srv/gkfeed/backups
BACKUP_PART_BYTES=45000000
BACKUP_MIN_FREE_BYTES=5368709120
